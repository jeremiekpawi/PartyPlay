# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SOCKET_URL: Optional external Socket.IO server URL when deploying the
# Next.js frontend on Vercel (e.g. "https://partyplay-socket.onrender.com").
# Leave empty in local development or unified Node hosting (same origin).
NEXT_PUBLIC_SOCKET_URL=""

# ALLOWED_ORIGIN: Comma-separated frontend origins allowed by the standalone
# Socket.IO server (e.g. "https://partyplay.vercel.app,http://localhost:3000").
# Leave empty to allow any origin in development.
ALLOWED_ORIGIN=""
